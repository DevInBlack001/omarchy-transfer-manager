{
  "schemaVersion": 1,
  "id": "filetransfer",
  "name": "Transfer Manager",
  "version": "1.0.0",
  "author": "DevInBlack001",
  "license": "MIT",
  "description": "Monitor and control queued file copy/move transfers, independent of any file manager.",
  "kinds": ["bar-widget"],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Transfer Manager",
    "description": "Pause, resume, cancel, and reorder queued file transfers.",
    "category": "Files",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "pollIntervalSec": 2
    },
    "schema": [
      {
        "key": "pollIntervalSec",
        "type": "integer",
        "label": "Poll interval (seconds)",
        "min": 1,
        "max": 30,
        "step": 1,
        "defaultValue": 2
      }
    ]
  }
}
